# Copy to deploy/.env and fill in. Never commit the real file.
LITELLM_MASTER_KEY=sk-change-me
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Sandbox for generated projects: e2b (needs E2B_API_KEY) | docker | local (no isolation, dev only)
SANDBOX_PROVIDER=e2b
E2B_API_KEY=
# Spend limits (empty = no limit)
MAX_COST_USD_PER_DAY=20
MAX_COST_USD_PER_RUN=5
BUDGET_ALERT_WEBHOOK_URL=
# Traces: set to http://otel-collector:4317 with --profile observability
OTEL_ENDPOINT=
LANGSMITH_API_KEY=
GRAFANA_ADMIN_PASSWORD=change-me

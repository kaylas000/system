# Copy to deploy/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# --- LLM gateway (OpenAI-compatible) ---------------------------------------------------------
# OmniRoute on the host:        http://host.docker.internal:20128/v1
# OmniRoute in the stack:       http://omniroute:20128/v1   (+ --profile omniroute)
# LiteLLM proxy in the stack:   http://litellm:4000         (+ --profile litellm; LLM_API_KEY = its master key)
LLM_GATEWAY_URL=http://host.docker.internal:20128/v1
# OmniRoute: Dashboard -> Endpoints -> API key
LLM_API_KEY=
# Kernel model names (router/coder, router/planner, router/classifier, ...) -> gateway model ids.
# "*" = every name not listed. OmniRoute: auto, auto/coding, auto/fast, auto/cheap or provider/model.
# Leave empty for LiteLLM (its config defines the router/* groups).
LLM_MODEL_ALIASES='{"*": "auto/coding", "router/classifier": "auto/fast", "router/enricher": "auto/cheap", "router/reranker": "auto/fast"}'
# OmniRoute: no lossy prompt compression, no memory/skills injection (generated code must stay exact)
LLM_EXTRA_HEADERS='{"x-omniroute-compression": "off", "x-omniroute-no-memory": "true"}'
# Knowledge-base embeddings: "hashing" = offline, no embedding model needed (keyword search only).
# With an embedding provider in the gateway: EMBEDDER=litellm, EMBEDDING_MODEL=<id>, EMBEDDING_DIM=<its size>
EMBEDDER=hashing
EMBEDDING_MODEL=
EMBEDDING_DIM=

# OmniRoute in the stack (--profile omniroute); generate: openssl rand -base64 48 / -hex 32
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_INITIAL_PASSWORD=
OMNIROUTE_STORAGE_ENCRYPTION_KEY=
# LiteLLM in the stack (--profile litellm): provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Sandbox for generated projects: e2b (needs E2B_API_KEY) | docker | local (no isolation, dev only)
SANDBOX_PROVIDER=e2b
E2B_API_KEY=
# Spend limits (empty = no limit)
MAX_COST_USD_PER_DAY=20
MAX_COST_USD_PER_RUN=5
BUDGET_ALERT_WEBHOOK_URL=
# Traces: set to http://otel-collector:4317 with --profile observability
OTEL_ENDPOINT=
LANGSMITH_API_KEY=
GRAFANA_ADMIN_PASSWORD=change-me
# Gateway /v1: false = no API keys needed (local debugging only)
GATEWAY_AUTH_ENABLED=true
# HS256 JWT secret (optional; API keys work without it) and HMAC secret for webhook signatures
GATEWAY_JWT_SECRET=
GATEWAY_WEBHOOK_SECRET=
